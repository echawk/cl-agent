;;;; t/test-parens.lisp -- fixing parentheses from indentation (parens.lisp)
;;;; and the tools that offer the fix.

(in-package :cl-agent)

(defun lines (&rest lines) (format nil "~{~a~^~%~}" lines))

(deftest parens-are-fixed-from-the-indentation ()
  (check-equal (fix-parens (lines "(defun add (a b)" "  (let ((s (+ a b)))" "    (* s 2)" "" "(defun next () 1)"))
               (lines "(defun add (a b)" "  (let ((s (+ a b)))" "    (* s 2)))" "" "(defun next () 1)")
               "missing closers, before the next toplevel form")
  (check-equal (fix-parens (lines "(defun f (x)" "  (when x" "    (print x))))))" "  (g x))"))
               (lines "(defun f (x)" "  (when x" "    (print x))" "  (g x))")
               "too many")
  (check-equal (fix-parens (lines "(defun f (x)" "  (let ((y 1)))" "    (+ x y)))"))
               (lines "(defun f (x)" "  (let ((y 1))" "    (+ x y)))")
               "closed too early: the body's indentation says it is inside")
  (check-equal (fix-parens (lines "(defun g ()" "  (list #\\( \"a ) (\" ; note )" "        #\\) |a)b|" "  (h \"x" "y ) z\""))
               (lines "(defun g ()" "  (list #\\( \"a ) (\" ; note )" "        #\\) |a)b|)" "  (h \"x" "y ) z\"))")
               "strings, comments, characters and |symbols| do not count")
  (check-equal (fix-parens (lines "#| ( |#" "(defun z ()" "  (q")) (lines "#| ( |#" "(defun z ()" "  (q))"))
  (let ((balanced (lines "(defun ok (x)" "  (car x))")))
    (check (eq (fix-parens balanced) balanced) "balanced text is left alone"))
  (let ((loose (lines "(defun loose ()" "  (let ((a 1)" "         (b 2))" "      (list a b)))" "(defun broken ()" "  (car x")))
    (check (search (lines "(defun loose ()" "  (let ((a 1)" "         (b 2))" "      (list a b)))") (fix-parens loose))
           "a balanced form keeps its own loose indentation; only the broken one is rebuilt")))

(deftest paren-problems-say-where ()
  (check-equal (paren-problems "(a (b c)") '((:unclosed 1 1)))
  (check-equal (paren-problems (lines "(a)" "  b)")) '((:extra 2 4)))
  (check (null (paren-problems (lines "(a \"(\" #\\( ; (" " b)")))))

(deftest tools-offer-the-paren-fix ()
  (let ((message (call-tool "eval-lisp" (jobj "form" (lines "(let ((x 1)" "  (+ x 1)")))))
    (check (search "\"(\" at line 1, column 1 never closed" message) message)
    (check (search "fix_parens: true" message) "says how to take the fix"))
  (check (search "3" (call-tool "eval-lisp" (jobj "form" (lines "(let ((x 1))" "  (+ x 2)") "fix_parens" t)))
         "fix_parens evaluates the fixed form")
  (check (search "Fixed source:" (call-tool "fix-parens" (jobj "source" "(a (b"))))
  (check-equal (call-tool "fix-parens" (jobj "source" "(a b)")) "Parentheses are balanced; nothing to fix.")
  (let ((path (merge-pathnames "fixme.lisp" *config-directory*)))
    (ensure-directories-exist path)
    (with-open-file (out path :direction :output :if-exists :supersede)
      (write-string (lines "(defun a ()" "  (b" "(defun c () 1)") out))
    (check (search "Saved" (call-tool "fix-parens" (jobj "path" (namestring path)))))
    (check-equal (uiop:read-file-string path) (lines "(defun a ()" "  (b))" "(defun c () 1)"))))
