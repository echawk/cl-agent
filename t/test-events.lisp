;;;; test-events.lisp -- durable session/event projections and task recovery.

(in-package :cl-agent)

(deftest durable-session-events-replay-and-branch-without-provider-work ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "remember this request")
      (let ((source-id (session-id session)))
        (record-session-event session :assistant-response-finished :component "fixture"
                              :payload (list :message (list :role "assistant" :content "durable reply")))
        ;; Keep the live cache aligned exactly as RUN-AGENT-TURN does.
        (setf (session-messages session)
              (append (session-messages session)
                      (list (list :role "assistant" :content "durable reply"))))
        (multiple-value-bind (events messages) (replay-session source-id)
          (check (>= (length events) 3))
          (check-equal (mapcar (lambda (message) (getf message :content)) messages)
                       (list (getf (first (session-messages session)) :content)
                             "remember this request" "durable reply")))
        (branch-session session)
        (check (not (string= source-id (session-id session))))
        (multiple-value-bind (events messages) (replay-session (session-id session))
          (check (find :session-branched events :key (lambda (event) (getf event :kind))))
          (check-equal (length messages) 3))
        (let ((restored (make-session (make-instance 'ollama-provider))))
          (resume-session restored source-id)
          (check-equal (mapcar (lambda (message) (getf message :content))
                               (session-messages restored))
                       (list (getf (first (session-messages session)) :content)
                             "remember this request" "durable reply")))))))

(deftest worker-recovery-never-reruns-interrupted-task-records ()
  (with-temp-config-dir ()
    (let ((path (subagent-task-store-path "interrupted-fixture")))
      (sexp-store:snapshot-write
       path
       (list :schema-version 1 :id "interrupted-fixture" :state :running
             :snapshot (list :id "interrupted-fixture" :state :running)))
      (let ((records (recover-subagent-task-records)))
        (check-equal (getf (first records) :state) :unknown)
        (multiple-value-bind (stored complete-p) (sexp-store:snapshot-read path)
          (check complete-p)
          (check-equal (getf stored :state) :unknown))))))

(deftest session-resume-reconciles-unmatched-tool-intents-as-unknown ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "perform a possibly side-effecting action")
      (let ((id (session-id session)))
        (record-session-event session :tool-call-started :component "fixture"
                              :payload (list :tool-call-id "unmatched-call" :tool-name "fixture"))
        (let ((resumed (make-session (make-instance 'ollama-provider))))
          (resume-session resumed id)
          (let ((message (car (last (session-messages resumed)))))
            (check-equal (getf message :role) "tool")
            (check (search "outcome unknown" (getf message :content)))))))))

(deftest durable-session-repairs-only-an-invalid-final-event-tail ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (id (session-id session))
           (tail (session-event-pathname id 2)))
      (write-string-atomically tail "(:truncated")
      (check (repair-session-event-tail id))
      (check (not (probe-file tail)))
      (multiple-value-bind (events messages) (replay-session id)
        (declare (ignore messages))
        (check-equal (length events) 1)))))

(deftest durable-session-refuses-a-corrupt-middle-event ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (id (session-id session)))
      (session-submit-user-text session "second event")
      (write-string-atomically (session-event-pathname id 1) "(:corrupt")
      (check-condition error (read-session-events id)))))
