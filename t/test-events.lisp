;;;; test-events.lisp -- durable session/event projections and task recovery.

(in-package :cl-agent)

(deftest durable-session-events-replay-and-branch-without-provider-work ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "remember this request")
      (let ((source-id (session-id session)))
        (record-session-event session :assistant-response-finished :component "fixture"
                              :payload (list :message (list :role "assistant" :content "durable reply")))
        ;; Keep the live cache aligned exactly as RUN-AGENT-TURN does.
        (setf (session-messages session)
              (append (session-messages session)
                      (list (list :role "assistant" :content "durable reply"))))
        (multiple-value-bind (events messages) (replay-session source-id)
          (check (>= (length events) 3))
          (check-equal (mapcar (lambda (message) (getf message :content)) messages)
                       (list (getf (first (session-messages session)) :content)
                             "remember this request" "durable reply")))
        (branch-session session)
        (check (not (string= source-id (session-id session))))
        (multiple-value-bind (events messages) (replay-session (session-id session))
          (check (find :session-branched events :key (lambda (event) (getf event :kind))))
          (check-equal (length messages) 3))
        (let ((restored (make-session (make-instance 'ollama-provider))))
          (resume-session restored source-id)
          (check-equal (mapcar (lambda (message) (getf message :content))
                               (session-messages restored))
                       (list (getf (first (session-messages session)) :content)
                             "remember this request" "durable reply")))))))

(deftest worker-recovery-never-reruns-interrupted-task-records ()
  (with-temp-config-dir ()
    (let ((path (subagent-task-store-path "interrupted-fixture")))
      (sexp-store:snapshot-write
       path
       (list :schema-version 1 :id "interrupted-fixture" :state :running
             :snapshot (list :id "interrupted-fixture" :state :running)))
      (let ((records (recover-subagent-task-records)))
        (check-equal (getf (first records) :state) :unknown)
        (multiple-value-bind (stored complete-p) (sexp-store:snapshot-read path)
          (check complete-p)
          (check-equal (getf stored :state) :unknown))))))

(deftest session-resume-reconciles-unmatched-tool-intents-as-unknown ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "perform a possibly side-effecting action")
      (let ((id (session-id session)))
        (record-session-event session :tool-call-started :component "fixture"
                              :payload (list :tool-call-id "unmatched-call" :tool-name "fixture"))
        (let ((resumed (make-session (make-instance 'ollama-provider))))
          (resume-session resumed id)
          (let ((message (car (last (session-messages resumed)))))
            (check-equal (getf message :role) "tool")
            (check (search "outcome unknown" (getf message :content)))))))))

(deftest durable-session-repairs-only-an-invalid-final-event-tail ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (id (session-id session))
           (tail (session-event-pathname id 2)))
      (write-string-atomically tail "(:truncated")
      (check (repair-session-event-tail id))
      (check (not (probe-file tail)))
      (multiple-value-bind (events messages) (replay-session id)
        (declare (ignore messages))
        (check-equal (length events) 1)))))

(deftest durable-session-refuses-a-corrupt-middle-event ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (id (session-id session)))
      (session-submit-user-text session "second event")
      (write-string-atomically (session-event-pathname id 1) "(:corrupt")
      (check-condition error (read-session-events id)))))

(deftest durable-tool-results-use-blobs-and-session-export-replays-them ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (text (make-string 13001 :initial-element #\x))
           (blob (write-session-blob session text))
           (export (merge-pathnames "session-export.sexp" *config-directory*)))
      (record-session-event session :tool-result-recorded :component "fixture"
                            :payload (list :message (list :role "tool" :tool-call-id "blob-fixture"
                                                          :content (subseq text 0 12000))
                                           :content-blob blob))
      (multiple-value-bind (events messages) (replay-session (session-id session))
        (declare (ignore events))
        (check-equal (getf (car (last messages)) :content) text))
      (export-session (session-id session) export)
      (check (probe-file export)))))

(deftest durable-file-rewind-requires-the-recorded-after-revision ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (path (merge-pathnames "rewind-fixture.txt" *config-directory*))
           (before "before") (after "after"))
      (write-string-atomically path after)
      (record-session-event
       session :file-edit-receipt :component "fixture" :status "finished"
       :payload (list :path (namestring path) :before-exists-p t
                      :before-digest (session-content-digest before)
                      :after-digest (session-content-digest after)
                      :before-blob (write-session-blob session before)
                      :after-blob (write-session-blob session after)))
      (multiple-value-bind (rewound restored) (rewind-session session 1 :files-p t)
        (declare (ignore rewound))
        (check-equal restored 1)
        (check-equal (uiop:read-file-string path) before))
      (write-string-atomically path "someone else")
      (check-condition error (rewind-session-files session (read-session-events (session-id session)) 1)))))

(deftest durable-compaction-is-a-replayable-projection ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "old request")
      (record-session-event session :assistant-response-finished :component "fixture"
                            :payload (list :message (list :role "assistant" :content "old answer")))
      (setf (session-messages session)
            (append (session-messages session) (list (list :role "assistant" :content "old answer"))))
      (let ((summary (list :role "system" :content "[User-requested context compaction]~%old work summary")))
        (setf (session-messages session) (list (first (session-messages session)) summary))
        (record-session-event session :context-compacted :component "context" :status "finished"
                              :payload (list :keep-recent 0 :message summary)))
      (multiple-value-bind (events messages) (replay-session (session-id session))
        (declare (ignore events))
        (check-equal (mapcar (lambda (message) (getf message :content)) messages)
                     (list (getf (first (session-messages session)) :content)
                           "[User-requested context compaction]~%old work summary"))))))

(deftest durable-session-name-survives-resume ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider)))
           (id (session-id session)))
      (check-equal (rename-session session "Roadmap implementation") "Roadmap implementation")
      (check-equal (getf (find id (list-durable-sessions) :key (lambda (entry) (getf entry :id))
                                   :test #'string=) :name)
                   "Roadmap implementation")
      (let ((resumed (make-session (make-instance 'ollama-provider))))
        (resume-session resumed id)
        (check-equal (session-display-name resumed) "Roadmap implementation")))))

(deftest named-durable-checkpoints-restore-their-projection ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "keep this")
      (check-equal (checkpoint-session session "before follow-up") "before follow-up")
      (let ((checkpoint (find-session-checkpoint (session-id session) "before follow-up")))
        (check checkpoint)
        ;; Task-start events are durable too, so the checkpoint follows the
        ;; accepted user message and its task-receipt start.
        (check-equal (getf checkpoint :through-sequence) 3)
        (session-submit-user-text session "discard this")
        (rewind-session session (getf checkpoint :through-sequence))
        (check-equal (mapcar (lambda (message) (getf message :content))
                             (session-messages session))
                     (list (getf (first (session-messages session)) :content) "keep this"))))))

(deftest provider-request-events-link-the-durable-response ()
  (with-temp-config-dir ()
    (let* ((session (make-session (make-instance 'ollama-provider) :tools nil))
           (stream (symbol-function 'chat-stream)))
      (unwind-protect
           (progn
             (setf (symbol-function 'chat-stream)
                   (lambda (provider messages tools on-delta)
                     (declare (ignore provider messages tools on-delta))
                     (list :role "assistant" :content "durable response" :tool-calls nil :usage nil)))
             (session-submit-user-text session "request")
             (run-agent-turn session)
             (let* ((events (read-session-events (session-id session)))
                    (request (find :provider-request-started events :key (lambda (event) (getf event :kind))))
                    (response (find :assistant-response-finished events :key (lambda (event) (getf event :kind)))))
               (check request)
               (check-equal (getf response :parent-id) (getf request :id))))
        (setf (symbol-function 'chat-stream) stream)))))

(deftest hook-execution-events-preserve-identity-and-outcome ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (unwind-protect
           (progn
             (add-hook :user-message 'durable-hook-fixture
                       (lambda (context)
                         (setf (getf context :text) "rewritten") context))
             (let ((*current-session* session))
               (run-hook-chain :user-message (list :text "original")))
             (let ((events (read-session-events (session-id session))))
               (check (find :hook-started events :key (lambda (event) (getf event :kind))))
               (check (find :hook-finished events :key (lambda (event) (getf event :kind))))))
        (remove-hook :user-message 'durable-hook-fixture)))))

(deftest task-receipts-project-from-session-events ()
  (with-temp-config-dir ()
    (let ((session (make-session (make-instance 'ollama-provider))))
      (session-submit-user-text session "durable task")
      (let ((record (session-task-record session)))
        (record-task-tool-evidence session (list :id "task-call" :name "fixture-tool") "proof")
        (set-task-record-status session "succeeded" "verified")
        (let ((projected (first (project-task-records (read-session-events (session-id session))))))
          (check-equal (getf projected :id) (jget record "id"))
          (check-equal (getf projected :state) "succeeded")
          (check-equal (getf (first (getf projected :tool-evidence)) :result-preview) "proof"))))))
