;;;; t/test-editor-files.lisp -- the working directory, and files edited
;;;; through the hosted Lem (lem/files.lisp, editor.lisp, file-routes.lisp).

(in-package :cl-agent)

(defmacro with-test-repository ((root &rest files) &body body)
  "Run BODY in a fresh directory ROOT holding FILES ((\"path\" \"text\") ...)
as the working directory; restore the directory and close every editor
buffer opened meanwhile."
  `(let ((,root (merge-pathnames (format nil "repo-~36r/" (random (expt 36 6))) *config-directory*))
         (saved-directory (uiop:getcwd))
         (saved-defaults *default-pathname-defaults*))
     (dolist (file (list ,@(mapcar (lambda (f) `(list ,@f)) files)))
       (let ((path (merge-pathnames (first file) ,root)))
         (ensure-directories-exist path)
         (with-open-file (out path :direction :output :if-exists :supersede) (write-string (second file) out))))
     (ensure-directories-exist ,root)
     (unwind-protect (progn (set-working-directory (uiop:native-namestring ,root)) ,@body)
       (dolist (buffer (ignore-errors (editor-buffers)))
         (ignore-errors (editor-close-file (gethash "path" buffer) :force t)))
       (uiop:chdir saved-directory)
       (setf *default-pathname-defaults* saved-defaults))))

(defun read-file-text (path) (uiop:read-file-string path))

(deftest the-working-directory-changes-with-a-hook ()
  (let ((seen nil))
    (add-hook :working-directory-changed 'test-cwd (lambda (old new) (push (list old new) seen)))
    (unwind-protect
         (with-test-repository (root ("sub/a.txt" "a"))
           (check (uiop:pathname-equal (uiop:getcwd) (truename root)))
           (check (uiop:pathname-equal *default-pathname-defaults* (truename root)) "relative paths follow")
           (set-working-directory "sub")
           (check (uiop:pathname-equal (uiop:getcwd) (truename (merge-pathnames "sub/" root))) "relative to the old one")
           (check-equal (length seen) 2)
           (check (uiop:pathname-equal (second (first seen)) (truename (merge-pathnames "sub/" root))))
           (check-condition error (set-working-directory "no-such-directory"))
           (check (search "Working directory is now"
                          (call-tool "set-working-directory" (jobj "directory" "..")))))
      (remove-hook :working-directory-changed 'test-cwd))))

(deftest directories-list-as-lem-lists-them ()
  (with-test-repository (root ("b.txt" "bb") ("a.lisp" "a") (".hidden" "") ("src/x.c" "x"))
    (let* ((listing (list-directory-json "."))
           (names (mapcar (lambda (e) (gethash "name" e)) (gethash "entries" listing))))
      (check-equal names '("src" "a.lisp" "b.txt") "directories first, dot files hidden")
      (check (gethash "directory" (first (gethash "entries" listing))))
      (check-equal (gethash "sizeText" (third (gethash "entries" listing))) "2")
      (check (uiop:pathname-equal (gethash "parent" listing) (uiop:pathname-parent-directory-pathname (truename root)))))
    (check (member ".hidden" (mapcar (lambda (e) (gethash "name" e))
                                     (gethash "entries" (list-directory-json "." :hidden t)))
                   :test #'string=))
    (check-equal (mapcar (lambda (c) (getf c :display)) (getf (find-file-completions "sr" ".") :candidates))
                 '("src/") "Lem's file completion")
    (check (search "src/x.c" (getf (first (getf (find-file-completions "src/x" ".") :candidates)) :value)))
    (check-condition error (list-directory-json "no-such-dir"))))

(deftest files-open-and-save-through-lem ()
  (let ((opened nil) (saved nil))
    (add-hook :file-opened 'test-opened (lambda (path) (push path opened)))
    (add-hook :after-file-save 'test-saved (lambda (path) (push path saved)))
    (add-hook :before-file-save 'test-header
              (lambda (plist) (list :path (getf plist :path) :text (concatenate 'string "/* hi */" (getf plist :text)))))
    (unwind-protect
         (with-test-repository (root ("main.c" (format nil "int x;~%")) ("run" (format nil "#!/bin/sh~%echo hi~%")))
           (let ((json (editor-open-file "main.c")))
             (check-equal (gethash "mode" json) "C" "Lem chose the mode")
             (check-equal (gethash "text" json) (format nil "int x;~%"))
             (check-equal (gethash "version" json) 0)
             (check-equal (length opened) 1 ":file-opened"))
           (check (search "shell" (string-downcase (gethash "mode" (editor-open-file "run"))))
                  "by its #! line, as Lem does")
           (multiple-value-bind (status version runs mode) (editor-update-file "main.c" (format nil "int y;~%") :base 0)
             (check-equal status :updated)
             (check-equal version 1)
             (check-equal mode "C")
             (check (find "sx-type" runs :key #'third :test #'equal) "highlighted by the buffer's mode"))
           (check-equal (read-file-text "main.c") (format nil "int x;~%") "nothing saved yet")
           (check (gethash "modified" (first (remove "main.c" (editor-buffers) :key (lambda (j) (gethash "name" j))
                                                                                :test-not #'equal))))
           (check-equal (editor-update-file "main.c" "stale" :base 0) :conflict "a stale page is told")
           (multiple-value-bind (status json) (editor-save-file "main.c")
             (check-equal status :saved)
             (check-equal (gethash "text" json) (format nil "/* hi */int y;~%") ":before-file-save rewrote it"))
           (check-equal (read-file-text "main.c") (format nil "/* hi */int y;~%"))
           (check-equal (length saved) 1 ":after-file-save")
           ;; Changed on disk underneath: not overwritten unless forced.
           (sleep 1.1)
           (with-open-file (out (merge-pathnames "main.c" root) :direction :output :if-exists :supersede)
             (write-string "changed elsewhere" out))
           (editor-update-file "main.c" "mine" :base nil)
           (check-equal (editor-save-file "main.c") :changed-on-disk)
           (check-equal (editor-save-file "main.c" :force t) :saved)
           (check-equal (read-file-text "main.c") "/* hi */mine")
           (check-condition error (progn (editor-update-file "main.c" "unsaved" :base nil)
                                         (editor-close-file "main.c")) "unsaved changes")
           (check-equal (gethash "text" (editor-revert-file "main.c")) "/* hi */mine" "revert reads the disk")
           (check (editor-close-file "main.c")))
      (remove-hook :file-opened 'test-opened)
      (remove-hook :after-file-save 'test-saved)
      (remove-hook :before-file-save 'test-header))))

(deftest lem-save-settings-apply-to-saved-files ()
  (let ((variable 'lem-core/commands/file::add-newline-at-eof-on-writing-file))
    (let ((old (lem:variable-value variable :global)))
      (setf (lem:variable-value variable :global) t)
      (unwind-protect
           (with-test-repository (root ("note.txt" "no newline"))
             (editor-open-file "note.txt")
             (editor-update-file "note.txt" "still none" :base 0)
             (let ((json (nth-value 1 (editor-save-file "note.txt"))))
               (check-equal (read-file-text "note.txt") (format nil "still none~%") "the user's Lem setting")
               (check-equal (gethash "text" json) (format nil "still none~%") "and the page is given the new text")))
        (setf (lem:variable-value variable :global) old)))))

(deftest agent-writes-refresh-open-buffers ()
  (with-test-repository (root ("src/a.c" "int a;"))
    (editor-open-file "src/a.c")
    (check (search "Wrote" (call-tool "write-file" (jobj "path" "src/a.c" "contents" "int b;")))
           "relative paths in subdirectories (once landed in src/src/)")
    (check-equal (lem-call (lambda () (editor-buffer-text (editor-find-buffer "src/a.c")))) "int b;"
                 "an unmodified buffer is read again")
    (editor-update-file "src/a.c" "int mine;" :base nil)
    (call-tool "write-file" (jobj "path" "src/a.c" "contents" "int agent;"))
    (check-equal (lem-call (lambda () (editor-buffer-text (editor-find-buffer "src/a.c")))) "int mine;"
                 "unsaved changes are kept")
    (check (search "unsaved changes" (call-tool "read-file" (jobj "path" "src/a.c"))) "the agent is told")
    (check (search "int mine;" (call-tool "editor-files" (jobj "action" "read" "path" "src/a.c"))))
    (check (search "unsaved changes" (call-tool "editor-files" (jobj))))))

(deftest files-are-created-renamed-and-deleted-as-in-dired ()
  (with-test-repository (root ("old.txt" "text"))
    (editor-create-file "new/inner.txt")
    (check (probe-file (merge-pathnames "new/inner.txt" root)))
    (editor-create-file "made" :directory t)
    (check (uiop:directory-exists-p (merge-pathnames "made/" root)))
    (check-condition error (editor-create-file "old.txt"))
    (editor-open-file "old.txt")
    (editor-rename-file "old.txt" "renamed.txt")
    (check (probe-file (merge-pathnames "renamed.txt" root)))
    (check (find "renamed.txt" (editor-buffers) :key (lambda (j) (gethash "name" j)) :test #'equal)
           "the open buffer follows the file")
    (editor-delete-file "renamed.txt")
    (check (not (probe-file (merge-pathnames "renamed.txt" root))))
    (check (not (find "renamed.txt" (editor-buffers) :key (lambda (j) (gethash "name" j)) :test #'equal)))))

(deftest the-language-server-sees-unsaved-text ()
  (with-fake-lsp-server ()
    (with-test-repository (root ("code.fakelang" "all fine"))
      (let ((path (expand-user-path "code.fakelang")))
        (check (null (path-diagnostics path)) "the saved file is fine")
        (check-equal (mapcar (lambda (d) (getf d :line)) (path-diagnostics path :text (format nil "ok~%FIXME")))
                     '(1) "the editor's unsaved text")
        (check (null (path-diagnostics path)) "and the disk's again after")
        (check-equal (scratch-completion-values (path-complete path "gre" 3 :unsaved t)) '("greet_all" "greeting"))
        (check-equal (read-file-text path) "all fine" "completion never saves a real file")))))

(deftest file-routes-over-http ()
  (with-test-repository (root ("app.c" (format nil "int main(void);~%")))
    (with-test-web-frontend (frontend)
      (let ((listing (web-get-json frontend "/api/files/list?dir=.")))
        (check-equal (mapcar (lambda (e) (gethash "name" e)) (gethash "entries" listing)) '("app.c")))
      (check (gethash "candidates" (web-get-json frontend "/api/files/complete?input=ap&dir=.")))
      (let ((json (json-decode (web-post frontend "/api/files/open" :json (jobj "path" "app.c")))))
        (check-equal (gethash "mode" json) "C")
        (let ((update (json-decode (web-post frontend "/api/files/update"
                                             :json (jobj "path" "app.c" "text" "int z;" "base" (gethash "version" json))))))
          (check (gethash "runs" update))
          (check-equal (nth-value 1 (web-post frontend "/api/files/update"
                                              :json (jobj "path" "app.c" "text" "x" "base" (gethash "version" json))))
                       409)))
      (check-equal (nth-value 1 (web-post frontend "/api/files/save" :json (jobj "path" "app.c"))) 200)
      (check-equal (read-file-text "app.c") "int z;")
      (check-equal (nth-value 1 (web-post frontend "/api/files/create" :json (jobj "path" "lib" "directory" t))) 200)
      (check-equal (nth-value 1 (web-post frontend "/api/cwd" :json (jobj "path" "lib"))) 200)
      (check (uiop:pathname-equal (uiop:getcwd) (truename (merge-pathnames "lib/" root))))
      (check-equal (nth-value 1 (web-post frontend "/api/cwd" :json (jobj "path" "nowhere"))) 404))))
