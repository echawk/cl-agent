;;;; t/test-environments.lisp -- development environments (environments.lisp):
;;;; definitions, a project's choice, and how commands are routed.  Nothing
;;;; here starts a container (the suite stays offline).

(in-package :cl-agent)

(defun write-test-environment (name &key (built t))
  (let ((directory (environment-directory name)))
    (ensure-directories-exist directory)
    (with-open-file (out (merge-pathnames "Containerfile" directory) :direction :output :if-exists :supersede)
      (write-string (format nil "FROM docker.io/library/alpine:3.20~%RUN apk add --no-cache jq~%") out))
    (save-environment-meta name (list :check "jq --version" :built (and built (get-universal-time))))))

(deftest environments-are-named-defined-and-chosen-per-project ()
  (with-temp-config-dir ()
    (check-equal (normalize-environment-name " Haskell ") "haskell")
    (check (search "letter" (handler-case (normalize-environment-name "../x") (error (c) (princ-to-string c)))))
    (write-test-environment "jq")
    (check-equal (getf (environment-definition "jq") :check) "jq --version")
    (check-equal (mapcar (lambda (e) (getf e :name)) (list-environments)) '("jq"))
    (check (null (project-environment "/p/one/")) "the host until chosen")
    (environment-use "jq" :mode :throwaway :root "/p/one/")
    (check-equal (project-environment "/p/one/") '(:name "jq" :mode :throwaway))
    (check (null (project-environment "/p/two/")) "per project")
    (environment-use nil :root "/p/one/")
    (check (null (project-environment "/p/one/")) "and back to the host")
    (check (search "define it first" (handler-case (environment-use "nope" :root "/p/one/") (error (c) (princ-to-string c)))))))

(deftest a-projects-commands-run-in-its-environment ()
  (if (null (structural-program-on-path "podman"))
      (check t "skipped: podman is not installed")
      (with-temp-config-dir ()
        (let ((*podman-connection* "test-machine"))
          (write-test-environment "jq")
          (check (null (environment-wrap-command "ls" :root "/p/one/")) "no environment: the host's own shell")
          (environment-use "jq" :mode :throwaway :root "/p/one/")
          (let ((argv (environment-wrap-command "jq --version" :directory "/p/one/src" :root "/p/one/")))
            (check-equal (subseq argv 1 7) '("--connection" "test-machine" "run" "--rm" "--interactive" "--volume"))
            (check (member "/p/one:/p/one" argv :test #'equal) "the project mounted at its own path")
            (check-equal (butlast (last argv 6)) (list "--workdir" "/p/one/src" (environment-image "jq") "sh" "-lc")
                         "in the same directory")
            (check-equal (car (last argv)) "jq --version"))
          (check-equal (environment-container-name "jq" "/p/one/") (environment-container-name "jq" "/p/one/")
                       "one container per environment and project")
          (check (string/= (environment-container-name "jq" "/p/one/") (environment-container-name "jq" "/p/two/")))))))
