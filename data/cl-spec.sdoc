       (:CELL NIL (:MATH NIL (:MI NIL "x") (:MO NIL "<") (:MN NIL "0")))
       (:CELL NIL " Negative x-axis ") (:CELL NIL (:MATH NIL (:MI NIL "π"))))
      (:ROW NIL
