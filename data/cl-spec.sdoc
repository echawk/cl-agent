     (:CODE NIL " (defun read-eval-print-loop (level)
   (with-simple-restart (abort \"Exit command level ~D.\" level)
     (loop
       (with-simple-restart (abort \"Return to command level ~D.\" level)
         (let ((form (prog2 (fresh-line) (read) (fresh-line))))
           (prin1 (eval form)))))))
