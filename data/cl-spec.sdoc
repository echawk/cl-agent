       (:TERM NIL "Pathnames") " and " (:TERM NIL "namestrings")
       " are two kinds of " (:TERM NIL "objects") " that substitute for "
       (:TERM NIL "filenames") " in " (:RM NIL " Common Lisp") ". "
       (:ENDISSUE NIL "PATHNAME-HOST-PARSING:RECOGNIZE-LOGICAL-HOST-NAMES") " "
