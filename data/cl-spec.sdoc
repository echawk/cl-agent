     (:ROW NIL (:CELL NIL (:TYPEREF NIL " file-stream"))
      (:CELL NIL (:TYPEREF NIL "reader-error"))
      (:CELL NIL (:TYPEREF NIL "two-way-stream")))
     (:ROW NIL (:CELL NIL (:TYPEREF NIL " float"))
