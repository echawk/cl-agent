     :PAR (:ISSUE NIL "DOCUMENTATION-FUNCTION-BUGS:FIX") " "
     (:COMMENT NIL "Signature for STANDARD-SLOT-DESCRIPTION removed.") :PAR
     (:B NIL " Functions, Macros, and Special Forms:") :PAR " "
