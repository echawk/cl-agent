     (:ROW NIL (:CELL NIL (:TYPEREF NIL " end-of-file"))
      (:CELL NIL (:TYPEREF NIL "random-state"))
      (:CELL NIL (:TYPEREF NIL "symbol")))
     (:ROW NIL (:CELL NIL (:TYPEREF NIL " error"))
