     (:ROW NIL (:CELL NIL " LF02 ") (:CELL NIL (:TT NIL "F"))
      (:CELL NIL " capital F ") (:CELL NIL " LS02 ") (:CELL NIL (:TT NIL "S"))
      (:CELL NIL " capital S "))
     (:ROW NIL (:CELL NIL " LG01 ") (:CELL NIL (:TT NIL "g"))
