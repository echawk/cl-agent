      (:CELL NIL (:TYPEREF NIL "simple-bit-vector")))
     (:ROW NIL (:CELL NIL (:TYPEREF NIL " atom"))
      (:CELL NIL (:TYPEREF NIL "integer"))
      (:CELL NIL (:TYPEREF NIL "simple-condition")))
     (:ROW NIL (:CELL NIL (:TYPEREF NIL " base-char"))
