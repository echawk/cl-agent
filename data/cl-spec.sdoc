      (:ITEM NIL (:B NIL "use") (:IDXTERM NIL "use") " " (:I NIL "v.t.") " (a "
       (:TERM NIL "package") " "
       (:MATH NIL (:MSUB NIL (:MI NIL "P") (:MN NIL "1"))) ") to "
       (:TERM NIL "inherit") " the " (:TERM NIL "external symbols") " of "
       (:MATH NIL (:MSUB NIL (:MI NIL "P") (:MN NIL "1"))) ". (If a package "
