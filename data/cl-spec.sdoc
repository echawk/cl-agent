        (:MATH NIL (:MI NIL "y") (:MO NIL "=") (:MO NIL "-") (:MN NIL "0")))
       (:CELL NIL (:MATH NIL (:MI NIL "x") (:MO NIL "<") (:MN NIL "0")))
