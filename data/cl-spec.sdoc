       (:PAREN NIL (:PARAM NIL "doc-type") " " (:TT NIL "(eql 'setf)"))))
     (:IDXREF NIL "setf") :PAR :PAR " " :PAR (:B NIL " Method Combinations:")
     :PAR " "
