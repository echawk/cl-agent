     (:ENDISSUE NIL "PRINT-CASE-BEHAVIOR:CLARIFY") " "
     (:ENDISSUE NIL "JUN90-TRIVIAL-ISSUES:3") " "
     (:ENDISSUE NIL
      "PRINT-CASE-PRINT-ESCAPE-INTERACTION:VERTICAL-BAR-RULE-NO-UPCASE")
