      (:CELL NIL " small e ") (:CELL NIL " LR01 ") (:CELL NIL (:TT NIL "r"))
      (:CELL NIL " small r "))
     (:ROW NIL (:CELL NIL " LE02 ") (:CELL NIL (:TT NIL "E"))
