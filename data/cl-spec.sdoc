      (:CELL NIL (:TYPEREF NIL "single-float")))
     (:ROW NIL (:CELL NIL (:TYPEREF NIL " cons"))
      (:CELL NIL (:TYPEREF NIL "rational"))
      (:CELL NIL (:TYPEREF NIL "string")))
     (:ROW NIL (:CELL NIL (:TYPEREF NIL " double-float"))
