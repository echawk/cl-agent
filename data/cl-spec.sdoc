       (:TERM NIL "function block name") " is computed. " :PAR)
      (:ITEM NIL (:B NIL "function cell") (:IDXTERM NIL "function cell") " "
       (:I NIL "n.") " " (:I NIL "Trad.") " (of a " (:TERM NIL "symbol")
